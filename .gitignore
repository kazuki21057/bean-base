app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
pictures/

# 日次ループの transient 状態ファイル
.claude/loop_state.md
.claude/loop_failures.txt
.claude/loop_boundary.txt

# Playwright MCP のスクリーンショット・スナップショット(実行のたびに生成される一時ファイル)
.playwright-mcp/

# Firebase CLI のデプロイキャッシュ
.firebase/

# ユーザーが調査用に貼り付けるスクリーンショット(個人的な内容を含むため追跡しない)
screenshots/

# tools/verify.sh / verify.ps1 の詳細ログ(実行のたびに生成される一時ファイル)
.claude/verify_logs/

# tools/ui_probe.ps1(ui_verifier)のスクショ・logcat・dumpXML等(実行のたびに生成される一時ファイル)
.claude/ui_verify/

# tools/night_loop.ps1 の実行ログ・実行記録・ロックファイル(実行のたびに生成される一時ファイル)
.claude/night_logs/
.claude/night_runs.log
.claude/night_loop.lock
.claude/night_loop_last_run.json
.claude/night_skips.log
.claude/night_usage_log.tsv

# tools/emulator.ps1 の起動時stdout/stderrログ(実行のたびに生成される一時ファイル)
.claude/emu_logs/

# golden test失敗時にflutter testが生成する差分画像(実行のたびに生成される一時ファイル)
test/golden/failures/

# tools/antigravity_delegate.ps1 / .sh(agy委譲ラッパー)のプロンプト・応答・生JSONログ
# (実行のたびに生成される一時ファイル。ledger.tsvの実績集計はT5-A38時点ではdocs/への
# 転記対象では無いため追跡しない)
.claude/agy_logs/

# tools/check_encoding.ps1(PostToolUseフック)が出すBOM有無の警告ログ
# (実行のたびに生成される一時ファイル)
.claude/encoding_warnings.log
